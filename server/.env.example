PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon Serverless PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your-neon-password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth Base URL (Optional for backend token verification)
NEON_AUTH_BASE_URL=https://ep-proud-dust-b3veypni.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
